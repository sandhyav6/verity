# Copy to .env and adjust. Placeholders only: never commit real secrets or private keys.
# Local development defaults; production values must come from your secret store.

# --- database (local development credentials; change for any shared environment)
DATABASE_URL=postgresql+psycopg://verity:CHANGE_ME@localhost:5433/verity

# --- blockchain (local Hardhat node by default)
RPC_URL=http://127.0.0.1:8545            # backend only; may contain a provider key
PUBLIC_RPC_URL=http://127.0.0.1:8545     # key-free URL sent to browsers via GET /config
CHAIN_NAME=Hardhat Local
CHAIN_ID=31337
# Printed by `npx hardhat run scripts/deploy.ts --network localhost` (contracts/deployments/local.json);
# `python scripts/make_env.py` fills these in for you.
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0                 # the deployBlock from local.json
INDEXER_CONFIRMATIONS=0       # 0 suits a local automine chain; use ~12 on a public network (reorgs are handled by rollback)
INDEXER_BATCH_SIZE=500
INDEXER_POLL_SECONDS=2
EXPLORER_TX_URL=              # e.g. https://sepolia.etherscan.io/tx/  (empty on a local chain)

# --- SIWE / sessions
SIWE_DOMAIN=localhost:5173    # must equal the frontend host[:port] the wallet shows when signing
SIWE_URI_PREFIX=http://localhost:5173
NONCE_TTL_SECONDS=300
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false           # true behind HTTPS

# --- API
ALLOWED_ORIGINS=["http://localhost:5173"]
PUBLIC_API_URL=http://localhost:8000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/minute

# --- document storage (files never go on-chain)
STORAGE_BACKEND=local         # an S3-compatible backend plugs in behind app.storage.base.Storage
STORAGE_DIR=backend/.storage  # use a persistent volume in production
MAX_UPLOAD_BYTES=26214400     # 25 MiB

# --- optional public-testnet deployment: keep the deployer key ONLY in your shell or secret store, never in git
# SEPOLIA_RPC_URL=
# DEPLOYER_PRIVATE_KEY=
# ADMIN_TRANSFER_DELAY=172800   # seconds the default-admin handover must wait (use days on a shared network)
